# EATLYY Web — environment variables
# Copy to .env.local for local development

# Base URL of the EATLYY backend API (leave empty if same origin)
NEXT_PUBLIC_API_URL=https://api.eatlyy.ru

# Telegram bot link
NEXT_PUBLIC_BOT_URL=https://t.me/EATLYY_bot

# Telegram support chat link
NEXT_PUBLIC_SUPPORT_URL=https://t.me/EATLYY_help

# Public site URL (used for SEO: sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://eatlyy.ru
