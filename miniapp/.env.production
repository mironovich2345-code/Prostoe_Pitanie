# Empty = relative mode (mini app and API on the same Express server / same domain).
# Set to the API origin ONLY if API runs on a separate hostname from the mini app.
# Example: VITE_API_URL=https://api.eatlyy.ru
# WARNING: Railway env vars override this file at build time.
#          If VITE_API_URL is set in Railway, it will cause cross-origin (absolute) mode.
VITE_API_URL=
