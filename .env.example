# Telegram Bot Token — получить у @BotFather
BOT_TOKEN=your_bot_token_here

# PostgreSQL URL — Railway автоматически выставляет эту переменную
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/database

# OpenAI API Key — получить на platform.openai.com
OPENAI_API_KEY=sk-...

# Mini App public URL — используется в кнопках Telegram-бота (WebApp button)
# Обновить здесь и в BotFather → Bot Settings → Menu Button при смене домена
MINIAPP_URL=https://app.example.com

# Allowed origin for CORS (может быть несколько через запятую)
# Должен совпадать с доменом, с которого открывается Mini App
MINIAPP_ORIGIN=https://app.example.com
